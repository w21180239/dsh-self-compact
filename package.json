{
  "name": "dsh-self-compact",
  "version": "0.2.0",
  "description": "Agent-initiated compaction for DeepSeek Harness: the model picks the milestone, writes the handoff, native compaction runs after the turn, and work resumes by itself.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-cn.md",
    "docs",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "compaction",
    "context-management",
    "context-window",
    "handoff"
  ],
  "license": "MIT OR Apache-2.0",
  "author": "w21180239",
  "homepage": "https://github.com/w21180239/dsh-self-compact#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w21180239/dsh-self-compact.git"
  },
  "bugs": {
    "url": "https://github.com/w21180239/dsh-self-compact/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import ./tests/register.mjs --test tests/logic.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-compaction": ">=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-token-meter": ">=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-compaction": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-token-meter": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
